{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "lib/*": ["./lib/*"],
      "tests/*": ["./tests/*"],
      "lib": ["./lib/index.ts"]
    }
  },
  "include": [
    "lib",
    "tests",
    "pages",
    "vite.config.ts",
    "main.tsx",
    "cosmos.decorator.tsx",
    "tailwind.config.ts"
  ]
}
